// Create a packing of Hertzian particles on a sphere
// by inflating the particles
import meshtools
import plot
import optimize4
import functionals
import pairwise

var Np = 500 // Number of particles

var Rmax = 2/sqrt(Np) // Maximum radius of particles

// Create the mesh: Np random points on the unit sphere
var build = MeshBuilder()
for (i in 1..Np) {
  var x = Matrix([2*random()-1, 2*random()-1, 2*random()-1])
  x/=x.norm() // Project onto unit sphere
  build.addvertex(x)
}
var mesh = build.build()

var hertz = HertzianPotential(0.01)
var lv = Pairwise(hertz, cutoff=2*Rmax)

var problem = OptimizationProblem(mesh)
problem.addEnergy(lv)

// Constrain particles to the unit sphere
var lsph = ScalarPotential(fn (x,y,z) x^2+y^2+z^2-1, fn (x,y,z) Matrix([2*x, 2*y, 2*z]))
problem.addLocalConstraint(lsph)

var adapter = ProblemAdapter(problem, mesh)

// Inflate, relaxing overlaps with a penalty formulation + L-BFGS.
// (Projected gradient descent is far too slow here: every step reprojects
// with an inner L-BFGS solve.)
for (sigma in 0.1*Rmax..2*Rmax:(2-0.1)*Rmax/40) {
  lv.cutoff = 2*sigma
  hertz.sigma = sigma
  var E0 = lv.total(mesh)
  if (E0 > 1e-12) {
    var pad = PenaltyAdapter(adapter, penalty=50)
    var opt = LBFGSController(pad, quiet=true)
    opt.recoverlinesearchfailure = true
    opt.optimize(200)
    print "sigma=${sigma} E=${lv.total(mesh)}"
  }
}

// Visualize the results
var g = Graphics()
for (i in 0...mesh.count()) {
  g.display(Sphere(mesh.vertexposition(i), hertz.sigma/2))
}
Show(g)
