import pairwise
import meshtools
import plot
import optimize4

var mb = MeshBuilder()
mb.addvertex([-1,-1,0])
mb.addvertex([-1,1,0])
mb.addvertex([1,-1,0])
mb.addvertex([1,1,0])
var m = mb.build()

var sigma = 0.5

fn visSpheres(m, sigma, color=nil) {
    var c = color
    if (isnil(c)) c = Gray(0.5)
    var g = Graphics()
    var R = sigma/2
    for (id in 0...m.count()) {
        g.display(Sphere(m.vertexposition(id), R, color=c))
    }
    return g
}

var ginit=visSpheres(m, sigma, color=Blue)

var lp = Pairwise(GravityPotential())
var lh = Pairwise(HertzianPotential(sigma))

var problem = OptimizationProblem(m)
problem.addEnergy(lp)
// Keep Hertzian strong enough to shield GravityPotential's -1/r singularity,
// so a quasi-Newton method can take large steps safely.
problem.addEnergy(lh, prefactor=200)

var adapter = ProblemAdapter(problem, m)
var opt = LBFGSController(adapter)
opt.optimize(500)

print m.vertexmatrix()

print lp.gradient(m)

print lh.gradient(m)

Show(ginit+visSpheres(m, sigma, color=Red))
