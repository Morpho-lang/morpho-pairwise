import pairwise
import meshtools
import optimize4
import plot

var Y = 0.55
var X = 0.075

var L = 0.5 // Length of cylinders
var R = 0.1 // Radius of cylinders
var sigma = 2*R // Cutoff

var mb = MeshBuilder()
mb.addvertex([-Y,-X,0])
mb.addvertex([Y,X,0])
var m = mb.build()

var f = Field(m, Matrix([L,0,0]))

fn vis(m, f) {
    var g = Graphics()
    for (id in 0...m.count()) {
        var x = m.vertexposition(id)
        var t = f[0,id]
        g.display(Sphere(x-t, R))
        g.display(Sphere(x+t, R))
        g.display(Cylinder(x-t, x+t, aspectratio=R/L))
    }
    return g
}

var hertz = HertzianPotential(sigma)

var problem = OptimizationProblem(m)
var lop = SpherocylinderOverlap(f, hertz)
problem.addEnergy(lop)

// Optimize orientations only (field DOFs)
var adapter = ProblemAdapter(problem, f)
var opt = LBFGSController(adapter)
opt.recoverlinesearchfailure = true
opt.optimize(50)

print "E=${lop.total(m)}"
Show(vis(m, f))
