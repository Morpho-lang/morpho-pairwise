// Pairwise on triangular facets approximated as point masses
import pairwise
import meshtools

var L = 1
var r = 0.1

var mb = MeshBuilder()
for (theta in 0...2*Pi:2*Pi/3) {
  mb.addvertex([-L+r*cos(theta),r*sin(theta),0])
}
for (theta in 0...2*Pi:2*Pi/3) {
  mb.addvertex([L-r*cos(theta),r*sin(theta),0])
}
mb.addface([0,1,2])
mb.addface([3,4,5])
var m = mb.build()

var c = CoulombPotential()
print abs(c.value(2) - 0.5) < 1e-15 // expect: true

var lp = Pairwise(c, grade=2)
print abs(lp.total(m) - 0.5) < 1e-10 // expect: true

var I = lp.integrand(m)
print isfield(I) // expect: true
print abs(I[1] - 0.5) < 1e-10 // expect: true

fn numericalgradient(func, m, eps=1e-8) {
   var x=m.vertexmatrix()
   var grad=x.clone()
   var dim = x.dimensions()[0]

   for (i in 0...m.count()) {
      for (j in 0...dim) {
         var temp = x[j,i]
         x[j,i]=temp+eps
         var fr=func.total(m)
         x[j,i]=temp-eps
         var fl=func.total(m)
         x[j,i]=temp
         grad[j,i]=(fr-fl)/(2*eps)
      }
   }

   return grad
}

print (lp.gradient(m) - numericalgradient(lp, m)).norm() < 1e-5 // expect: true
