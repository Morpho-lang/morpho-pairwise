// Periodic pairwise interactions
import pairwise
import meshtools

var lp = Pairwise(CoulombPotential(), box=1) // box of side length 1 centered at the origin

var mb = MeshBuilder()
mb.addvertex([0.0,0,0])
mb.addvertex([0.2,0,0])
var m = mb.build()

print isfield(lp.integrand(m)) // expect: true
print abs(lp.integrand(m)[1] - 5) < 1e-12 // expect: true
print abs(lp.gradient(m).column(0)[0] - 25) < 1e-10 // expect: true
print abs(lp.gradient(m).column(1)[0] + 25) < 1e-10 // expect: true

// Vertex is now at a distance 0.4 to the left of the first vertex across the periodic boundary
m.setvertexposition(1, Matrix([0.6, 0, 0]))
print abs(lp.integrand(m)[1] - 2.5) < 1e-12 // expect: true
print abs(lp.gradient(m).column(0)[0] + 6.25) < 1e-10 // expect: true
print abs(lp.gradient(m).column(1)[0] - 6.25) < 1e-10 // expect: true

// Vertex is now at a distance 0.1 to the right of the first vertex across the periodic boundary
m.setvertexposition(1, Matrix([-1.9, 0, 0]))
print abs(lp.integrand(m)[1] - 10) < 1e-12 // expect: true
print abs(lp.gradient(m).column(0)[0] - 100) < 1e-8 // expect: true
print abs(lp.gradient(m).column(1)[0] + 100) < 1e-8 // expect: true
