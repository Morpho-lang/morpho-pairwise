// Potentials: value and derivative checks
import pairwise

var g = GravityPotential()
print abs(g.value(2) + 0.5) < 1e-15 // expect: true
print abs(g.derivative(2) - 0.25) < 1e-15 // expect: true

var c = CoulombPotential()
print abs(c.value(2) - 0.5) < 1e-15 // expect: true
print abs(c.derivative(2) + 0.25) < 1e-15 // expect: true

var h = HertzianPotential(1)
print abs(h.value(0.5) - 0.5^2.5) < 1e-12 // expect: true
print abs(h.derivative(0.5) + 2.5*0.5^1.5) < 1e-12 // expect: true
print abs(h.value(2)) < 1e-15 // expect: true
print abs(h.derivative(2)) < 1e-15 // expect: true

var sigma = 1.0
var x = 1.3
var lj = LJPotential(sigma)
var v = 4*((sigma/x)^12-(sigma/x)^6)
var vprime = -24 * ((2 * (sigma/x)^12) - (sigma/x)^6) / x
print abs(lj.value(x) - v) < 1e-12 // expect: true
print abs(lj.derivative(x) - vprime) < 1e-12 // expect: true
print abs(lj.value(1)) < 1e-15 // expect: true
