// Basic Pairwise functional with Coulomb potential
import pairwise
import meshtools

var mb = MeshBuilder()
mb.addvertex([0,0,0])
mb.addvertex([1,0,0])
mb.addvertex([0,1,0])
mb.addvertex([1,1,0])
var m = mb.build()

var c = CoulombPotential()
print abs(c.value(2) - 0.5) < 1e-15 // expect: true

var lp = Pairwise(c, cutoff=2)

// Four unit-square corners: total Coulomb energy is 4 + sqrt(2)
print abs(lp.total(m) - (4 + sqrt(2))) < 1e-5 // expect: true

var I = lp.integrand(m)
print abs(I.column(1)[0] - 1) < 1e-12 // expect: true
print abs(I.column(2)[0] - (1 + 1/sqrt(2))) < 1e-5 // expect: true
print abs(I.column(3)[0] - (2 + 1/sqrt(2))) < 1e-5 // expect: true

var G = lp.gradient(m)
print abs(G.column(0)[0] - (1 + 1/sqrt(2)/2)) < 1e-5 // expect: true
print abs(G.column(1)[0] + (1 + 1/sqrt(2)/2)) < 1e-5 // expect: true
