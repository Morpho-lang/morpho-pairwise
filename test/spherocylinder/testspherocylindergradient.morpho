// Spherocylinder analytic vs numerical gradients
import pairwise
import meshtools

fn numericalgradient(func, m, eps=1e-8) {
   var x=m.vertexmatrix()
   var grad=x.clone()
   var dim = x.dimensions()[0]

   for (i in 0...m.count()) {
      for (j in 0...dim) {
         var temp = x[j,i]
         x[j,i]=temp+eps
         var fr=func.total(m)
         x[j,i]=temp-eps
         var fl=func.total(m)
         x[j,i]=temp
         grad[j,i]=(fr-fl)/(2*eps)
      }
   }

   return grad
}

fn numericalfieldgradient(func, m, f, eps=1e-8) {
   var grad=f.clone()
   var lmat=f.__linearize()
   var gmat=grad.__linearize()

   var len=lmat.dimensions()[0]

   for (i in 0...len) {
      var temp = lmat[i]
      lmat[i]=temp+eps
      var fr=func.total(m)
      lmat[i]=temp-eps
      var fl=func.total(m)
      lmat[i]=temp
      gmat[i]=(fr-fl)/(2*eps)
   }

   return grad
}

var mb = MeshBuilder()
mb.addvertex([-2,0,0])
mb.addvertex([2,0,0])
var m = mb.build()

var f = Field(m, Matrix([1,0,0]))
var sc = SpherocylinderOverlap(f)

print abs(sc.total(m) - 2) < 1e-15 // expect: true
print (sc.gradient(m) - numericalgradient(sc, m)).norm() < 1e-6 // expect: true
print (sc.fieldgradient(m).__linearize() - numericalfieldgradient(sc, m, f).__linearize()).norm() < 1e-6 // expect: true
